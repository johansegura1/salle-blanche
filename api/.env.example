# Pas de guillemets autour des valeurs : `docker run --env-file` les garderait.
# La base SQLite. Dans compose, elle vit dans un volume : file:/app/db/salle-blanche.db
DATABASE_URL=file:./dev.db
JWT_SECRET=dev-secret-change-me-in-production
PORT=3000
# Là où tourne le front : la seule origine autorisée à appeler l'API depuis un navigateur
WEB_ORIGIN=http://localhost:5173
