datasource db {
  provider = "sqlite"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// La salle blanche. SQLite n'a pas d'union de chaînes : `role`, `zone` et
// `status` sont des chaînes, restreintes dans le code (user.ts, equipment.ts,
// reservation.ts).

model User {
  id           String @id @default(uuid())
  username     String @unique
  name         String
  role         String // 'manager' | 'user'
  passwordHash String

  createdAt DateTime @default(now())

  habilitations Habilitation[]
  reservations  Reservation[]
}

model Equipment {
  id   String @id @default(uuid())
  code String @unique // "SB-042"
  name String
  zone String // 'PREPARATION' | 'FABRICATION' | 'LITHOGRAPHIE'

  habilitations Habilitation[]
  reservations  Reservation[]
  maintenances  Maintenance[]
}

// Une personne formée sur un équipement : la seule condition pour le réserver.
model Habilitation {
  id          String    @id @default(uuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId String
  grantedBy   String // le nom d'utilisateur du gestionnaire
  grantedAt   DateTime  @default(now())

  @@unique([userId, equipmentId])
}

// Une réservation n'est jamais supprimée : elle passe à CANCELLED, avec la
// raison, pour que son auteur voie qu'elle a été annulée et pourquoi.
model Reservation {
  id           String    @id @default(uuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId  String
  start        DateTime
  end          DateTime
  status       String    @default("ACTIVE") // 'ACTIVE' | 'CANCELLED'
  note         String? // ex. « Pour l'entreprise X », quand un gestionnaire réserve
  cancelReason String?
  createdAt    DateTime  @default(now())

  @@index([equipmentId, start])
  @@index([userId])
}

// Une période pendant laquelle l'équipement ne peut pas être réservé.
model Maintenance {
  id          String    @id @default(uuid())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId String
  start       DateTime
  end         DateTime
  reason      String
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([equipmentId, start])
}
